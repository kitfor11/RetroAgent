# 把本文件复制一份命名为 .env，然后填入你的真实 key（.env 不要提交到 git）
DEEPSEEK_API_KEY=sk-在这里填你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Redis 连接（本机默认配置，装了 Redis 后无需改）
REDIS_HOST=localhost
REDIS_PORT=6379

# Embedding 后端：ngram（默认，零依赖）或 sentence_transformers（真实语义，需先 pip install sentence-transformers）
EMBEDDING_BACKEND=ngram
# 仅当 EMBEDDING_BACKEND=sentence_transformers 时生效（多语言语义模型）
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
